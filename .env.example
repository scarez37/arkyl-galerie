# ===================================================================
# Variables d'environnement ARKYL (à définir chez l'hébergeur : Render / Railway)
# NE JAMAIS mettre de vraies valeurs dans ce fichier ni sur GitHub.
# ===================================================================

# ── Base de données Supabase ─────────────────────────────────────────
# Supabase > Project Settings > Database > Connection string > « Session pooler »
# Si le mot de passe contient @ : / ? # % → l'encoder (ex. @ devient %40)
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Connexions ───────────────────────────────────────────────────────
# Chaîne aléatoire de 32+ caractères  (ex. : openssl rand -hex 32)
AUTH_SECRET=
# E-mails administrateurs (comptes Google vérifiés), séparés par des virgules
ADMIN_EMAILS=
# Identifiant client Google (par défaut : celui du site)
# GOOGLE_CLIENT_ID=

# ── Site / CORS ──────────────────────────────────────────────────────
APP_URL=https://arkyl.site
ALLOWED_ORIGINS=https://arkyl.site,https://www.arkyl.site

# ── Paiement Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
